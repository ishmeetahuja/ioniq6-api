# Copy to android/keystore.properties (gitignored) for a locally signed release build.
# CI does not read this file. It uses the ANDROID_* secrets listed in CONTRIBUTING.md.
#
# storeFile is a path to your .jks. Relative paths are from the android/ directory.

storeFile=/absolute/path/to/release.jks
storePassword=
keyAlias=walkaway
keyPassword=
