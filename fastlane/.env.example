# Local TestFlight upload. Copy to fastlane/.env (gitignored) if you run fastlane
# on a Mac. GitHub Actions does not read this file; it reads the secrets named below.
# Leave the values empty in git. Never commit a real key, certificate or profile.

# App Store Connect API key (Users and Access → Integrations → App Store Connect API).
ASC_KEY_ID=
ASC_ISSUER_ID=
# Absolute path to the downloaded AuthKey_XXXXXX.p8. In CI this is written from ASC_KEY_P8_BASE64.
ASC_KEY_PATH=

# Signing. The profile must be an App Store profile for the public bundle id in
# config/public.properties (io.github.ishmeetahuja.walkawaylock).
APPLE_TEAM_ID=
IOS_DIST_CERT_PASSWORD=
IOS_DIST_CERT_P12=
IOS_PROFILE=

# Optional. Defaults are config/public.properties (iosScheme) and ios/WalkawayLock.xcodeproj.
# IOS_SCHEME=WalkawayLock
# IOS_PROJECT=ios/WalkawayLock.xcodeproj
