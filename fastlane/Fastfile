# Uploads an already-built IPA to TestFlight.
# The GitHub Actions workflow builds the IPA with xcodebuild, then calls `fastlane ios upload`.
# Every value comes from the environment. There are no keys in this file.

default_platform(:ios)

platform :ios do
  desc "Upload IPA_PATH to TestFlight with an App Store Connect API key"
  lane :upload do
    ipa = ENV["IPA_PATH"]
    UI.user_error!("IPA_PATH is not set") if ipa.nil? || ipa.empty?
    UI.user_error!("IPA not found at #{ipa}") unless File.exist?(ipa)

    key_path = ENV["ASC_KEY_PATH"]
    UI.user_error!("ASC_KEY_PATH is not set") if key_path.nil? || key_path.empty?
    UI.user_error!("API key file not found at #{key_path}") unless File.exist?(key_path)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
